# Copy this file to .env and replace the local development password.
POSTGRES_DB=tiris
POSTGRES_USER=tiris
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# New GitHub platform connections: enter Token in the Sources page; encrypted per source.
# This environment value remains optional for legacy connections/scripts.
# Never commit tokens or the .local-secrets directory to Git.
# GitHub: https://github.com/settings/personal-access-tokens
# Optional for public reads; required for /user/starred. Grant only required read permissions.
GITHUB_TOKEN=
# arXiv, public RSS, public Black Hat/web pages do not require API keys.
# Raw PDF/HTML budgets; exceeding them is partial/failure, never silent truncation.
MATERIAL_MAX_BYTES=20000000
PDF_MAX_PAGES=200
REDIS_URL=redis://localhost:6379/0
# system is default; opt in to doh only when a Fake-IP proxy rewrites public DNS.
FETCH_DNS_MODE=system

# Cloud embeddings: use YOUR workspace/region Base URL from the Bailian console.
# Never use a DeepSeek key here. Empty defaults disable external calls.
BAILIAN_API_KEY=
BAILIAN_BASE_URL=
# Service alias is not an immutable weight revision; bump this when upgrading/reindexing.
BAILIAN_EMBEDDING_REVISION=service-v1
