# Copy this file to .env and replace the local development password.
POSTGRES_DB=tiris
POSTGRES_USER=tiris
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional: public repository metadata/releases do not require a token.
GITHUB_TOKEN=
REDIS_URL=redis://localhost:6379/0
# system is default; opt in to doh only when a Fake-IP proxy rewrites public DNS.
FETCH_DNS_MODE=system

# Cloud embeddings: use YOUR workspace/region Base URL from the Bailian console.
# Never use a DeepSeek key here. Empty defaults disable external calls.
BAILIAN_API_KEY=
BAILIAN_BASE_URL=
# Service alias is not an immutable weight revision; bump this when upgrading/reindexing.
BAILIAN_EMBEDDING_REVISION=service-v1
